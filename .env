# Default receiver settings for Docker Compose. Change these for your installation.
# This file is tracked as an example configuration: NEVER commit real MQTT passwords.
#
# Receiver identity used for MQTT topics and Home Assistant discovery.
# Choose a different ID for each receiver if you run more than one.
RECEIVER_HOSTNAME=egergy-receiver

# Osmocom SDR device argument. Default is the first RTL-SDR.
# Uncomment the bladeRF line and comment the RTL-SDR line to switch devices.
ENGAGE_SDR_ARGS=rtl=0
#ENGAGE_SDR_ARGS=bladerf=0

# MQTT broker address (IP address or resolvable hostname).
# .local/mDNS names may not resolve in all container environments.
ENGAGE_MQTT_HOST=homeassistant.local

# MQTT credentials. These are example defaults, not secure production credentials.
# Replace with your own values before deployment; don't push real secrets to Git.
ENGAGE_MQTT_USER=mqtt
ENGAGE_MQTT_PASSWORD=mqtt

# Optional packet activity LED. Empty means OFF (default).
# If enabled, set a GPIO line offset; for example 16 on a Raspberry Pi.
# Docker also needs compose.gpio.yaml to map the gpiochip device.
ENGAGE_STATUS_LED_GPIO=
# Character device containing the GPIO line above (libgpiod v2).
ENGAGE_STATUS_LED_CHIP=/dev/gpiochip0
