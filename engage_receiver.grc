- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "\"\"\"GNU Radio 3.10 Embedded Python Block: multi-sensor Efergy\
      \ MQTT publisher.\n\nInput: PMT dictionary messages on port 'packet' from the\
      \ existing decoder.\nRF availability times out 45 seconds after the last validated\
      \ packet for each sensor.\nRequires paho-mqtt 2.x. No stream inputs or outputs.\n\
      \"\"\"\nimport json\nimport os\nimport re\nimport threading\nimport time\nfrom\
      \ datetime import datetime, timezone\n\nimport pmt\nfrom gnuradio import gr\n\
      import paho.mqtt.client as mqtt\n\n\nclass blk(gr.basic_block):\n    def __init__(self,\
      \ mqtt_host=\"localhost\", mqtt_port=1883,\n                 mqtt_user=\"\"\
      , mqtt_password=\"\",\n                 mqtt_topic=\"efergy/events\", receiver_id=None,\n\
      \                 sensor_topic_prefix=\"engage\"):\n        gr.basic_block.__init__(self,\
      \ name=\"MQTT Multi-Sensor + RF Watchdog\",\n                              \
      \  in_sig=None, out_sig=None)\n        self.mqtt_topic = str(mqtt_topic).strip().strip('/')\n\
      \        self.prefix = str(sensor_topic_prefix).strip().strip('/')\n       \
      \ receiver_id = receiver_id or os.uname().nodename\n        self.receiver_id\
      \ = re.sub(r'[^a-zA-Z0-9_-]', '_', str(receiver_id)).strip('_')\n        self.rf_timeout\
      \ = 45.0  # seconds since last validated packet\n        if not self.prefix\
      \ or not self.receiver_id or not self.mqtt_topic:\n            raise ValueError(\"\
      mqtt_topic, sensor_topic_prefix and receiver_id are required\")\n\n        #\
      \ A receiver is a real MQTT client; each transmitter has independent RF status.\n\
      \        self.receiver_topic = f\"{self.prefix}/receivers/{self.receiver_id}/availability\"\
      \n        self.sensors = {}  # sensor_id -> last_valid, interval, rf_online,\
      \ last_packet\n        self.connected = False\n        self.lock = threading.RLock()\n\
      \        self.stopping = threading.Event()\n\n        self.message_port_register_in(pmt.intern(\"\
      packet\"))\n        self.set_msg_handler(pmt.intern(\"packet\"), self.handle_packet)\n\
      \n        client_id = f\"gnuradio_{self.receiver_id}_{os.getpid()}\"\n     \
      \   self.client = mqtt.Client(\n            callback_api_version=mqtt.CallbackAPIVersion.VERSION2,\n\
      \            client_id=client_id,\n            protocol=mqtt.MQTTv311,\n   \
      \     )\n        if str(mqtt_user):\n            self.client.username_pw_set(str(mqtt_user),\
      \ str(mqtt_password))\n        self.client.will_set(self.receiver_topic, \"\
      offline\", qos=1, retain=True)\n        self.client.on_connect = self.on_connect\n\
      \        self.client.on_message = self.on_message\n        self.client.on_disconnect\
      \ = self.on_disconnect\n        self.client.on_connect_fail = self.on_connect_fail\n\
      \        self.client.reconnect_delay_set(min_delay=1, max_delay=30)\n      \
      \  self.client.connect_async(str(mqtt_host), int(mqtt_port), keepalive=60)\n\
      \        self.client.loop_start()\n\n        self.watchdog = threading.Thread(target=self._watchdog_loop,\n\
      \                                          name=\"engage-rf-watchdog\", daemon=True)\n\
      \        self.watchdog.start()\n        print(f\"MQTT starting client={client_id}\"\
      , flush=True)\n\n    def _base(self, sensor_id):\n        # Sensor state is\
      \ namespaced by receiver AND transmitter, avoiding\n        # collisions if\
      \ a second SDR hears the same sensor on another Pi.\n        return f\"{self.prefix}/receivers/{self.receiver_id}/sensors/{sensor_id}\"\
      \n\n    def _rf_topic(self, sensor_id):\n        return f\"{self._base(sensor_id)}/rf_availability\"\
      \n\n    def _state_topic(self, sensor_id):\n        return f\"{self._base(sensor_id)}/state\"\
      \n\n    def _publish(self, topic, value, retain=False):\n        try:\n    \
      \        result = self.client.publish(topic, value, qos=1, retain=retain)\n\
      \            if result.rc != mqtt.MQTT_ERR_SUCCESS:\n                print(f\"\
      MQTT publish error on {topic}: \"\n                      f\"{mqtt.error_string(result.rc)}\
      \ ({result.rc})\", flush=True)\n                return False\n            return\
      \ True\n        except Exception as exc:\n            print(f\"MQTT publish\
      \ exception on {topic}: {exc}\", flush=True)\n            return False\n\n \
      \   def _discovery(self, sensor_id):\n        # Publish per transmitter only\
      \ when first seen and after MQTT reconnect.\n        device_key = f\"engage_{self.receiver_id}_{sensor_id}\"\
      \n        rf_topic = self._rf_topic(sensor_id)\n        common = {\n       \
      \     \"state_topic\": self._state_topic(sensor_id),\n            \"availability_mode\"\
      : \"all\",\n            \"availability\": [\n                {\"topic\": self.receiver_topic,\
      \ \"payload_available\": \"online\",\n                 \"payload_not_available\"\
      : \"offline\"},\n                {\"topic\": rf_topic, \"payload_available\"\
      : \"online\",\n                 \"payload_not_available\": \"offline\"},\n \
      \           ],\n            \"device\": {\n                \"identifiers\":\
      \ [device_key],\n                \"name\": f\"Engage E2CT {sensor_id} ({self.receiver_id})\"\
      ,\n                \"manufacturer\": \"Efergy\", \"model\": \"e2CT\",\n    \
      \        },\n        }\n        entities = (\n            (\"sensor\", \"current\"\
      , \"Current\", {\n                \"value_template\": \"{{ value_json.current\
      \ | round(3) }}\",\n                \"unit_of_measurement\": \"A\", \"device_class\"\
      : \"current\",\n                \"state_class\": \"measurement\",\n        \
      \    }),\n            (\"binary_sensor\", \"battery_low\", \"Battery Low\",\
      \ {\n                \"value_template\": \"{{ 'OFF' if value_json.battery_ok\
      \ else 'ON' }}\",\n                \"device_class\": \"battery\", \"payload_on\"\
      : \"ON\", \"payload_off\": \"OFF\",\n            }),\n            (\"sensor\"\
      , \"last_received\", \"Last Received\", {\n                \"value_template\"\
      : \"{{ value_json.received_at }}\",\n                \"device_class\": \"timestamp\"\
      , \"entity_category\": \"diagnostic\",\n            }),\n            (\"sensor\"\
      , \"packet_count\", \"Packet Count\", {\n                \"value_template\"\
      : \"{{ value_json.sensor_packet_count }}\",\n                \"entity_category\"\
      : \"diagnostic\", \"icon\": \"mdi:counter\",\n            }),\n            (\"\
      binary_sensor\", \"checksum_error\", \"Checksum Error\", {\n               \
      \ \"value_template\": \"{{ 'OFF' if value_json.checksum_ok else 'ON' }}\",\n\
      \                \"device_class\": \"problem\", \"payload_on\": \"ON\", \"payload_off\"\
      : \"OFF\",\n                \"entity_category\": \"diagnostic\",\n         \
      \   }),\n            (\"sensor\", \"rssi\", \"RSSI\", {\n                \"\
      value_template\": \"{{ value_json.rssi | default(none) }}\",\n             \
      \   \"unit_of_measurement\": \"dBFS\", \"state_class\": \"measurement\",\n \
      \               \"entity_category\": \"diagnostic\", \"icon\": \"mdi:signal\"\
      ,\n            }),\n            (\"sensor\", \"snr\", \"SNR\", {\n         \
      \       \"value_template\": \"{{ value_json.snr | default(none) }}\",\n    \
      \            \"unit_of_measurement\": \"dB\", \"state_class\": \"measurement\"\
      ,\n                \"entity_category\": \"diagnostic\", \"icon\": \"mdi:signal-variant\"\
      ,\n            }),\n            (\"sensor\", \"noise\", \"Noise Floor\", {\n\
      \                \"value_template\": \"{{ value_json.noise | default(none) }}\"\
      ,\n                \"unit_of_measurement\": \"dBFS\", \"state_class\": \"measurement\"\
      ,\n                \"entity_category\": \"diagnostic\", \"icon\": \"mdi:waveform\"\
      ,\n            }),\n            (\"sensor\", \"freq1\", \"FSK High Frequency\"\
      , {\n                \"value_template\": \"{{ value_json.freq1 | default(none)\
      \ }}\",\n                \"unit_of_measurement\": \"MHz\", \"state_class\":\
      \ \"measurement\",\n                \"entity_category\": \"diagnostic\", \"\
      icon\": \"mdi:sine-wave\",\n            }),\n            (\"sensor\", \"freq2\"\
      , \"FSK Low Frequency\", {\n                \"value_template\": \"{{ value_json.freq2\
      \ | default(none) }}\",\n                \"unit_of_measurement\": \"MHz\", \"\
      state_class\": \"measurement\",\n                \"entity_category\": \"diagnostic\"\
      , \"icon\": \"mdi:sine-wave\",\n            }),\n            (\"sensor\", \"\
      fsk_deviation_khz\", \"FSK Deviation\", {\n                \"value_template\"\
      : \"{{ value_json.fsk_deviation_khz | default(none) }}\",\n                \"\
      unit_of_measurement\": \"kHz\", \"state_class\": \"measurement\",\n        \
      \        \"entity_category\": \"diagnostic\", \"icon\": \"mdi:waveform\",\n\
      \            }),\n            (\"sensor\", \"reception_rate\", \"Reception Rate\"\
      , {\n                \"value_template\": \"{{ value_json.reception_rate | default(none)\
      \ }}\",\n                \"unit_of_measurement\": \"%\", \"state_class\": \"\
      measurement\",\n                \"entity_category\": \"diagnostic\", \"icon\"\
      : \"mdi:percent\",\n            }),\n            (\"sensor\", \"packets_missed_est\"\
      , \"Estimated Missed Packets\", {\n                \"value_template\": \"{{\
      \ value_json.packets_missed_est | default(none) }}\",\n                \"entity_category\"\
      : \"diagnostic\", \"icon\": \"mdi:counter\",\n            }),\n        )\n \
      \       for component, entity, name, extra in entities:\n            config\
      \ = dict(common)\n            config.update({\"name\": name, \"unique_id\":\
      \ f\"{device_key}_{entity}\"})\n            config.update(extra)\n         \
      \   topic = f\"homeassistant/{component}/{device_key}_{entity}/config\"\n  \
      \          self._publish(topic, json.dumps(config), retain=True)\n\n    def\
      \ on_message(self, client, userdata, msg):\n        # Reset retained RF status\
      \ from a previous process incarnation.\n        if not msg.retain:\n       \
      \     return\n        prefix = f\"{self.prefix}/receivers/{self.receiver_id}/sensors/\"\
      \n        suffix = \"/rf_availability\"\n        if not msg.topic.startswith(prefix)\
      \ or not msg.topic.endswith(suffix):\n            return\n        key = msg.topic[len(prefix):-len(suffix)]\n\
      \        if not key.isdecimal():\n            return\n        sensor_id = int(key)\n\
      \        if sensor_id > 65535:\n            return\n        with self.lock:\n\
      \            if sensor_id in self.sensors or not self.connected:\n         \
      \       return\n            self.sensors[sensor_id] = {\n                \"\
      last_valid\": float(\"-inf\"), \"interval\": 6,\n                \"rf_online\"\
      : False, \"last_packet\": None,\n                \"count\": 0, \"recovered\"\
      : True,\n            }\n            self._publish(self._rf_topic(sensor_id),\
      \ \"offline\", retain=True)\n        print(f\"RF sensor {sensor_id} awaiting\
      \ first valid packet\", flush=True)\n\n    def on_connect(self, client, userdata,\
      \ flags, reason_code, properties):\n        if reason_code.is_failure:\n   \
      \         with self.lock:\n                self.connected = False\n        \
      \    print(f\"MQTT connection rejected: {reason_code}\", flush=True)\n     \
      \       return\n        now = time.monotonic()\n        with self.lock:\n  \
      \          self.connected = True\n            snapshots = [\n              \
      \  (sid, now - state[\"last_valid\"] <\n                 self.rf_timeout, state[\"\
      last_packet\"])\n                for sid, state in self.sensors.items()\n  \
      \          ]\n            for sid, valid, _ in snapshots:\n                self.sensors[sid][\"\
      rf_online\"] = valid\n        subscription = f\"{self.prefix}/receivers/{self.receiver_id}/sensors/+/rf_availability\"\
      \n        result, _ = client.subscribe(subscription, qos=1)\n        if result\
      \ != mqtt.MQTT_ERR_SUCCESS:\n            print(f\"RF availability subscription\
      \ failed: {result}\", flush=True)\n        print(\"MQTT connected\", flush=True)\n\
      \        for sensor_id, valid, packet in snapshots:\n            self._discovery(sensor_id)\n\
      \            self._publish(self._rf_topic(sensor_id),\n                    \
      \      \"online\" if valid else \"offline\", retain=True)\n            if packet\
      \ is not None:\n                self._publish(self._state_topic(sensor_id),\
      \ json.dumps(packet), retain=False)\n        self._publish(self.receiver_topic,\
      \ \"online\", retain=True)\n        print(f\"Discovery refreshed for {len(snapshots)}\
      \ sensor(s)\", flush=True)\n\n    def on_disconnect(self, client, userdata,\
      \ flags, reason_code, properties):\n        with self.lock:\n            self.connected\
      \ = False\n        if not self.stopping.is_set():\n            print(f\"MQTT\
      \ disconnected: {reason_code} \"\n                  f\"(code={getattr(reason_code,\
      \ 'value', '?')})\", flush=True)\n\n    def on_connect_fail(self, client, userdata):\n\
      \        if not self.stopping.is_set():\n            print(\"MQTT transport\
      \ connect failed; retrying\", flush=True)\n\n    def handle_packet(self, msg):\n\
      \        data = pmt.to_python(msg)\n        if not isinstance(data, dict) or\
      \ not data.get(\"checksum_ok\"):\n            return\n        try:\n       \
      \     sensor_id = int(data[\"id\"])\n            interval = int(data.get(\"\
      interval\", 6))\n            if not 0 <= sensor_id <= 65535 or interval not\
      \ in (6, 12, 18):\n                return\n            data[\"received_at\"\
      ] = datetime.fromtimestamp(\n                float(data[\"timestamp\"]), tz=timezone.utc).isoformat()\n\
      \            data[\"current\"] = round(float(data[\"current\"]), 3)\n      \
      \  except (KeyError, TypeError, ValueError, OverflowError) as exc:\n       \
      \     print(f\"Malformed decoded packet: {exc}\", flush=True)\n            return\n\
      \n        now = time.monotonic()\n        with self.lock:\n            first_seen\
      \ = sensor_id not in self.sensors or self.sensors[sensor_id].get(\"recovered\"\
      , False)\n            if first_seen:\n                self.sensors[sensor_id]\
      \ = {\n                    \"last_valid\": now, \"interval\": interval,\n  \
      \                  \"rf_online\": True, \"last_packet\": data, \"count\": 0,\n\
      \                }\n                was_offline = True\n            else:\n\
      \                sensor = self.sensors[sensor_id]\n                was_offline\
      \ = not sensor[\"rf_online\"]\n                sensor.update(last_valid=now,\
      \ interval=interval,\n                              rf_online=True, last_packet=data,\
      \ recovered=False)\n            self.sensors[sensor_id][\"count\"] += 1\n  \
      \          data[\"sensor_packet_count\"] = self.sensors[sensor_id][\"count\"\
      ]\n            self.sensors[sensor_id][\"last_packet\"] = data\n           \
      \ connected = self.connected\n\n        if not connected:\n            print(f\"\
      RF valid id={sensor_id}, MQTT disconnected\", flush=True)\n            return\n\
      \        if first_seen:\n            self._discovery(sensor_id)\n          \
      \  print(f\"Discovered Efergy sensor {sensor_id}\", flush=True)\n        if\
      \ was_offline:\n            self._publish(self._rf_topic(sensor_id), \"online\"\
      , retain=True)\n            print(f\"RF sensor {sensor_id} online ({interval}s\
      \ interval)\", flush=True)\n        self._publish(self._state_topic(sensor_id),\
      \ json.dumps(data))\n        # Optional shared event stream remains compatible\
      \ with existing subscriptions.\n        self._publish(self.mqtt_topic, json.dumps(data))\n\
      \n    def _watchdog_loop(self):\n        while not self.stopping.wait(1.0):\n\
      \            now = time.monotonic()\n            expired = []\n            with\
      \ self.lock:\n                for sensor_id, sensor in self.sensors.items():\n\
      \                    timeout = self.rf_timeout\n                    if sensor[\"\
      rf_online\"] and now - sensor[\"last_valid\"] >= timeout:\n                \
      \        sensor[\"rf_online\"] = False\n                        expired.append((sensor_id,\
      \ timeout))\n                connected = self.connected\n            for sensor_id,\
      \ timeout in expired:\n                if connected:\n                    self._publish(self._rf_topic(sensor_id),\
      \ \"offline\", retain=True)\n                print(f\"RF sensor {sensor_id}\
      \ offline after {timeout:g}s\", flush=True)\n\n    def stop(self):\n       \
      \ self.stopping.set()\n        self.watchdog.join(timeout=2)\n        if self.client.is_connected():\n\
      \            with self.lock:\n                ids = list(self.sensors)\n   \
      \         topics = [self.receiver_topic] + [self._rf_topic(sid) for sid in ids]\n\
      \            for topic in topics:\n                try:\n                  \
      \  result = self.client.publish(topic, \"offline\", qos=1, retain=True)\n  \
      \                  if result.rc == mqtt.MQTT_ERR_SUCCESS:\n                \
      \        result.wait_for_publish(timeout=2)\n                except (RuntimeError,\
      \ ValueError):\n                    pass\n        self.client.disconnect()\n\
      \        self.client.loop_stop()\n        return True\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    mqtt_host: os.environ.get("ENGAGE_MQTT_HOST", "homeassistant.local")
