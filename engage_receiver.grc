- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"GNU Radio Embedded Python Block: Efergy E2CT decoder with\
      \ adaptive detection.\n\nInput 0: uint8 FSK binary slicer output (0/1)\nInput\
      \ 1: float32 averaged complex-IQ power, same sample rate\nInput 2: float32 quadrature\
      \ demodulator output (after float lowpass), same sample rate\nOutput: 'packet'\
      \ PMT dictionary\n\nOptimization: vectorized monitoring and bulk processing\
      \ of noise-only spans.\nCaptures still use the original sample-by-sample detector\
      \ and packet decoder.\n\"\"\"\nimport math\nimport os\nimport time\nfrom collections import\
      \ deque\n\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\n# Logging\
      \ settings: edit here; no new GRC constructor properties required.\n# normal:\
      \ one PKT line for each valid packet + summary every 5 minutes.\n# debug: also\
      \ show 10-second RF monitor and rejection details.\n# quiet: print only warnings/gaps,\
      \ no routine packet or summary logs.\nLOG_LEVEL = \"normal\"  # \"quiet\", \"\
      normal\", \"debug\"\nSUMMARY_INTERVAL = 300.0  # seconds; 0 disables periodic\
      \ summaries\n\n\nclass blk(gr.sync_block):\n    def __init__(self, sample_rate=500000,\
      \ detection_mode=\"adaptive\",\n                 detection_snr_db=10.0, release_snr_db=6.0,\n\
      \                 noise_time_constant=1.0, min_detection_us=100.0,\n       \
      \          threshold_on=0.01, threshold_off=0.003,\n                 initial_noise_power=0.00012,\
      \ center_freq=433.53e6, debug=False):\n        gr.sync_block.__init__(\n   \
      \         self, name=\"Engage E2CT Decoder\",\n            in_sig=[np.uint8,\
      \ np.float32, np.float32], out_sig=[])\n        self.fs = float(sample_rate)\n\
      \        self.center_freq = float(center_freq)\n        if not math.isfinite(self.center_freq):\n\
      \            raise ValueError(\"center_freq must be finite\")\n        self.mode\
      \ = str(detection_mode).lower()\n        self.on = float(threshold_on)\n   \
      \     self.off = float(threshold_off)\n        self.debug = bool(debug)\n  \
      \      self.noise = float(initial_noise_power)\n        self.ratio_on = 10 **\
      \ (float(detection_snr_db) / 10)\n        self.ratio_off = 10 ** (float(release_snr_db)\
      \ / 10)\n        if self.fs <= 0 or self.mode not in (\"adaptive\", \"manual\"\
      ):\n            raise ValueError(\"sample_rate must be positive; detection_mode\
      \ must be adaptive or manual\")\n        if self.mode == \"manual\" and not\
      \ 0 <= self.off < self.on:\n            raise ValueError(\"manual threshold_off\
      \ must be below threshold_on\")\n        if self.mode == \"adaptive\" and not\
      \ self.ratio_on > self.ratio_off > 1:\n            raise ValueError(\"adaptive\
      \ detection_snr_db must exceed release_snr_db, both > 0\")\n        if self.noise\
      \ <= 0 or noise_time_constant <= 0:\n            raise ValueError(\"initial_noise_power\
      \ and noise_time_constant must be positive\")\n\n        self.alpha = -math.expm1(-1.0\
      \ / (self.fs * float(noise_time_constant)))\n        self.decay = 1.0 - self.alpha\n\
      \        self.detect_samples = max(1, round(float(min_detection_us) * 1e-6 *\
      \ self.fs))\n        self.pre_samples = max(1, round(0.003 * self.fs))\n   \
      \     self.end_samples = max(1, round(0.002 * self.fs))\n        self.max_samples\
      \ = max(1, round(0.080 * self.fs))\n        self.history = deque(maxlen=self.pre_samples)\n\
      \        self.power_history = deque(maxlen=self.pre_samples)\n        self.freq_history\
      \ = deque(maxlen=self.pre_samples)\n        self.receiving = False\n       \
      \ self.candidate_count = 0\n        self.low_count = 0\n        self.data =\
      \ []\n        self.power_data = []\n        self.freq_data = []\n        self.capture_noise\
      \ = self.noise\n        self.capture_off_threshold = self.noise * self.ratio_off\n\
      \        self.packet_count = 0\n        self.reject_count = 0\n        self.stats\
      \ = {key: 0 for key in (\n            \"captures\", \"valid\", \"too_short\"\
      , \"no_sync\", \"no_64_symbols\",\n            \"checksum_failed\", \"invalid_payload\"\
      , \"capture_timeout\")}\n        self.stats_interval = float(SUMMARY_INTERVAL)\n\
      \        self.stats_last_print = time.monotonic()\n        self.last_valid_time\
      \ = {}  # per sensor, not global\n        self.sensor_reception = {}  # id ->\
      \ {received, missed}, since decoder start\n        self.monitor_interval = 10.0\n\
      \        self.monitor_started = time.monotonic()\n        self.monitor_samples\
      \ = 0\n        self.monitor_peak = 0.0\n        self.monitor_above = 0\n   \
      \     self.monitor_captures = 0\n        self.monitor_valid = 0\n        self.monitor_rejected\
      \ = 0\n        self.message_port_register_out(pmt.intern(\"packet\"))\n        # Optional GPIO LED: disabled unless ENGAGE_STATUS_LED_GPIO is set.\n        self._status_led = None\n        self._status_led_deadline = 0.0\n        led_gpio = os.environ.get(\"ENGAGE_STATUS_LED_GPIO\", \"\").strip()\n        if led_gpio:\n            try:\n                import gpiod\n                from gpiod.line import Direction, Value\n\n                self._status_led_gpio = int(led_gpio)\n                self._status_led_value = Value\n                self._status_led = gpiod.request_lines(\n                    os.environ.get(\"ENGAGE_STATUS_LED_CHIP\", \"/dev/gpiochip0\"),\n                    consumer=\"engage-status-led\",\n                    config={self._status_led_gpio: gpiod.LineSettings(\n                        direction=Direction.OUTPUT,\n                        output_value=Value.INACTIVE,\n                    )},\n                )\n            except (ImportError, AttributeError, OSError, ValueError, RuntimeError) as exc:\n                print(f\"STATUS LED unavailable: {exc}\", flush=True)\n\n    def _set_status_led(self, value):\n        if self._status_led is None:\n            return\n        try:\n            self._status_led.set_value(self._status_led_gpio, value)\n        except (OSError, RuntimeError) as exc:\n            print(f\"STATUS LED write failed: {exc}\", flush=True)\n            try:\n                self._status_led.release()\n            except (OSError, RuntimeError):\n                pass\n            self._status_led = None\n\n    def stop(self):\n        if self._status_led is not None:\n            self._set_status_led(self._status_led_value.INACTIVE)\n            if self._status_led is not None:\n                self._status_led.release()\n                self._status_led = None\n        return True\n\n  \
      \  def _thresholds(self):\n        if self.mode == \"manual\":\n           \
      \ return self.on, self.off\n        return self.noise * self.ratio_on, self.noise\
      \ * self.ratio_off\n\n    def _quiet_span(self, bits, powers, frequencies):\n\
      \        \"\"\"Bulk-update idle samples while preserving EMA and pre-trigger\
      \ history.\n\n        This is only called when every power sample is safely\
      \ below the\n        entry threshold. The complete span is known to contain\
      \ no trigger.\n        \"\"\"\n        n = len(powers)\n        if not n:\n\
      \            return\n        # Equivalent to a per-sample EMA for constant or\
      \ changing idle input:\n        # y[n] = d**n*y[0] + alpha*sum(d**(n-1-k)*x[k]).\n\
      \        # Chunk sizes stay modest, avoiding excessively large temp arrays.\n\
      \        if self.mode in (\"adaptive\", \"manual\"):\n            weights =\
      \ np.power(self.decay, np.arange(n - 1, -1, -1, dtype=np.float64))\n       \
      \     self.noise = (self.decay ** n) * self.noise + self.alpha * float(\n  \
      \              np.dot(weights, powers.astype(np.float64, copy=False)))\n   \
      \     self.history.extend(int(b) for b in bits[-self.pre_samples:])\n      \
      \  self.power_history.extend(float(p) for p in powers[-self.pre_samples:])\n\
      \        self.freq_history.extend(float(f) for f in frequencies[-self.pre_samples:])\n\
      \        self.candidate_count = 0\n\n    def _process_sample(self, bit, level,\
      \ frequency):\n        \"\"\"Original detector, used whenever a burst might\
      \ be present.\"\"\"\n        bit = int(bit)\n        level = float(level)\n\
      \        frequency = float(frequency) if math.isfinite(float(frequency)) else\
      \ 0.0\n        if not math.isfinite(level) or level < 0:\n            level\
      \ = 0.0\n        on, off = self._thresholds()\n        if not self.receiving:\n\
      \            self.history.append(bit)\n            self.power_history.append(level)\n\
      \            self.freq_history.append(frequency)\n            if level >= on:\n\
      \                self.candidate_count += 1\n                if self.candidate_count\
      \ >= self.detect_samples:\n                    self.receiving = True\n     \
      \               self.data = list(self.history)\n                    self.power_data\
      \ = list(self.power_history)\n                    self.freq_data = list(self.freq_history)\n\
      \                    self.capture_noise = self.noise\n                    self.capture_off_threshold\
      \ = off\n                    self.low_count = 0\n                    self.candidate_count\
      \ = 0\n                return\n            self.candidate_count = 0\n      \
      \      self.noise += self.alpha * (level - self.noise)\n            return\n\
      \n        self.data.append(bit)\n        self.power_data.append(level)\n   \
      \     self.freq_data.append(frequency)\n        if level < off:\n          \
      \  self.low_count += 1\n        else:\n            self.low_count = 0\n    \
      \    if self.low_count >= self.end_samples or len(self.data) >= self.max_samples:\n\
      \            timed_out = len(self.data) >= self.max_samples\n            packet\
      \ = np.asarray(self.data, dtype=np.uint8)\n            powers = np.asarray(self.power_data,\
      \ dtype=np.float32)\n            frequencies = np.asarray(self.freq_data, dtype=np.float32)\n\
      \            self.receiving = False\n            self.data = []\n          \
      \  self.power_data = []\n            self.freq_data = []\n            self.history.clear()\n\
      \            self.power_history.clear()\n            self.freq_history.clear()\n\
      \            self.stats[\"captures\"] += 1\n            self.monitor_captures\
      \ += 1\n            if timed_out:\n                self.stats[\"capture_timeout\"\
      ] += 1\n            self._decode_capture(packet, powers, frequencies,\n    \
      \                             self.capture_noise, self.capture_off_threshold)\n\
      \n    def work(self, input_items, output_items):\n        # Clear the pulse from an earlier valid packet without blocking DSP.\n        if self._status_led_deadline and time.monotonic() >= self._status_led_deadline:\n            self._set_status_led(self._status_led_value.INACTIVE)\n            self._status_led_deadline = 0.0\n        digital, power, frequencies\
      \ = input_items\n        n = min(len(digital), len(power), len(frequencies))\n\
      \        if n == 0:\n            return 0\n        digital = digital[:n]\n \
      \       power = power[:n]\n        frequencies = frequencies[:n]\n        #\
      \ Vectorized monitoring (the previous version performed these operations\n \
      \       # 500,000 times per second in the Python loop).\n        finite = np.isfinite(power)\n\
      \        clean_power = np.where(finite & (power >= 0), power, 0.0)\n       \
      \ self.monitor_samples += n\n        self.monitor_peak = max(self.monitor_peak,\
      \ float(np.max(clean_power)))\n        self.monitor_above += int(np.count_nonzero(clean_power\
      \ >= self._thresholds()[0]))\n\n        # Keep the size small so the adaptive\
      \ threshold cannot move much inside\n        # a chunk. Guard against moving\
      \ noise estimates by requiring all values\n        # below a CONSERVATIVE lower\
      \ bound on the threshold; otherwise use the\n        # exact original per-sample\
      \ path.\n        CHUNK = 512\n        for start in range(0, n, CHUNK):\n   \
      \         end = min(start + CHUNK, n)\n            p = clean_power[start:end]\n\
      \            b = digital[start:end]\n            f = frequencies[start:end]\n\
      \            on, _ = self._thresholds()\n            if (not self.receiving\
      \ and self.candidate_count == 0\n                    and float(np.max(p)) <\
      \ on * 0.75):\n                self._quiet_span(b, p, f)\n            else:\n\
      \                for bit, level, freq in zip(b, p, f):\n                   \
      \ self._process_sample(bit, level, freq)\n\n        now = time.monotonic()\n\
      \        if now - self.monitor_started >= self.monitor_interval:\n         \
      \   elapsed = now - self.monitor_started\n            rate = self.monitor_samples\
      \ / elapsed if elapsed > 0 else 0.0\n            on, off = self._thresholds()\n\
      \            if LOG_LEVEL == \"debug\":\n                print(\n          \
      \          f\"RF {elapsed:.0f}s processed={rate/1000:.1f} kS/s \"\n        \
      \            f\"peak={self.monitor_peak:.4g} noise={self.noise:.3g} \"\n   \
      \                 f\"on={on:.3g} off={off:.3g} \"\n                    f\"above_on={100\
      \ * self.monitor_above / max(1,self.monitor_samples):.3f}% \"\n            \
      \        f\"state={'RECEIVING' if self.receiving else 'IDLE'} \"\n         \
      \           f\"captures={self.monitor_captures} \"\n                    f\"\
      valid={self.monitor_valid} rejected={self.monitor_rejected}\",\n           \
      \         flush=True)\n            self.monitor_started = now\n            self.monitor_samples\
      \ = 0\n            self.monitor_peak = 0.0\n            self.monitor_above =\
      \ 0\n            self.monitor_captures = 0\n            self.monitor_valid =\
      \ 0\n            self.monitor_rejected = 0\n        if self.stats_interval >\
      \ 0 and now - self.stats_last_print >= self.stats_interval:\n            if\
      \ LOG_LEVEL != \"quiet\":\n                self._report_stats()\n          \
      \  self.stats_last_print = now\n        return n\n\n    @staticmethod\n    def\
      \ _decode_payload(raw):\n        if len(raw) != 8 or (raw[0] & 0xF0) != 0:\n\
      \            return None\n        if sum(b == 0 for b in raw) > 5:\n       \
      \     return None\n        checksum_sum = sum(raw[:7])\n        if checksum_sum\
      \ == 0:\n            return None\n        checksum_calc = checksum_sum & 0xFF\n\
      \        checksum_rx = raw[7]\n        if checksum_calc != checksum_rx:\n  \
      \          return None\n        exponent = 15 - raw[6]\n        if not 7 <=\
      \ exponent <= 23:\n            return None\n        interval = (((raw[3] & 0x30)\
      \ >> 4) + 1) * 6\n        return {\n            \"model\": \"Efergy-e2CT\",\
      \ \"id\": raw[1] | (raw[2] << 8),\n            \"current\": ((raw[4] << 8) |\
      \ raw[5]) / float(1 << exponent),\n            \"battery_ok\": bool(raw[3] &\
      \ 0x40), \"interval\": interval,\n            \"learn\": bool(raw[3] & 0x80),\
      \ \"mic\": \"CHECKSUM\",\n            \"checksum_received\": checksum_rx, \"\
      checksum_calculated\": checksum_calc,\n            \"checksum_ok\": True, \"\
      raw\": raw.hex(),\n        }\n\n    @staticmethod\n    def _rf_metrics(powers,\
      \ noise_power, release_threshold):\n        tiny = 1e-15\n        noise_power\
      \ = max(float(noise_power), tiny)\n        active = powers[powers >= max(float(release_threshold),\
      \ noise_power * 2)]\n        if active.size == 0:\n            return None\n\
      \        signal_power = max(float(np.median(active)), tiny)\n        signal_excess\
      \ = max(signal_power - noise_power, tiny)\n        return {\n            \"\
      rssi\": round(10 * math.log10(signal_power), 2),\n            \"noise\": round(10\
      \ * math.log10(noise_power), 2),\n            \"snr\": round(10 * math.log10(signal_excess\
      \ / noise_power), 2),\n            \"rf_power_unit\": \"dBFS\",\n        }\n\
      \n    def _frequency_metrics(self, samples, powers, demod, release_threshold):\n\
      \        \"\"\"Estimate the two FSK tone frequencies from stable pulse interiors.\n\
      \n        Quad Demod gain=1 output is radians/sample; scale by fs/(2*pi).\n\
      \        Drop 12 us at each edge to avoid low-pass transition ringing.\n   \
      \     Mask samples without RF power to avoid noise-only frequency values.\n\
      \        \"\"\"\n        if len(samples) != len(powers) or len(samples) != len(demod):\n\
      \            return {}\n        edges = np.flatnonzero(np.diff(samples.astype(np.int16)))\
      \ + 1\n        starts = np.r_[0, edges]\n        ends = np.r_[edges, len(samples)]\n\
      \        guard = max(1, round(12e-6 * self.fs))\n        threshold = max(float(release_threshold),\
      \ 1e-12)\n        tone_samples = [[], []]\n        for start, end in zip(starts,\
      \ ends):\n            if end - start < 2 * guard + 10:\n                continue\n\
      \            a, b = start + guard, end - guard\n            active = powers[a:b]\
      \ >= threshold\n            if not np.any(active):\n                continue\n\
      \            values = demod[a:b][active]\n            values = values[np.isfinite(values)]\n\
      \            if values.size:\n                tone_samples[int(samples[start])].append(values)\n\
      \        if not all(tone_samples):\n            return {}\n        tones = [np.concatenate(parts)\
      \ for parts in tone_samples]\n        # Require a minimum number of stable samples\
      \ for each tone.\n        if min(len(t) for t in tones) < 30:\n            return\
      \ {}\n        hz = [float(np.median(t)) * self.fs / (2 * math.pi) for t in tones]\n\
      \        low, high = sorted(hz)\n        return {\n            \"mod\": \"FSK\"\
      ,\n            \"freq1\": round((self.center_freq + high) / 1e6, 6),\n     \
      \       \"freq2\": round((self.center_freq + low) / 1e6, 6),\n            \"\
      fsk_deviation_khz\": round((high - low) / 2000.0, 3),\n        }\n\n    def\
      \ _publish_packet(self, measurement):\n        measurement[\"timestamp\"] =\
      \ time.time()\n        now = time.monotonic()\n        sensor_id = measurement[\"\
      id\"]\n        previous = self.last_valid_time.get(sensor_id)\n        if previous\
      \ is not None:\n            gap = now - previous\n            expected = float(measurement[\"\
      interval\"])\n            if gap >= 1.5 * expected:\n                print(f\"\
      GAP id={sensor_id} {gap:.1f}s since previous valid packet \"\n             \
      \         f\"(expected {expected:g}s)\", flush=True)\n        counters = self.sensor_reception.setdefault(sensor_id,\
      \ {\"received\": 0, \"missed\": 0})\n        if previous is not None:\n    \
      \        # Infer missed intervals between valid packets. There is no RF\n  \
      \          # sequence number, so this is an estimate, not a direct count.\n\
      \            expected_interval = float(measurement[\"interval\"])\n        \
      \    intervals = max(1, round((now - previous) / expected_interval))\n     \
      \       counters[\"missed\"] += max(0, intervals - 1)\n        counters[\"received\"\
      ] += 1\n        total = counters[\"received\"] + counters[\"missed\"]\n    \
      \    measurement[\"packets_received\"] = counters[\"received\"]\n        measurement[\"\
      packets_missed_est\"] = counters[\"missed\"]\n        measurement[\"reception_rate\"\
      ] = round(100.0 * counters[\"received\"] / total, 2)\n        self.last_valid_time[sensor_id]\
      \ = now\n        self.packet_count += 1\n        self.stats[\"valid\"] += 1\n\
      \        self.monitor_valid += 1\n        measurement[\"packet_count\"] = self.packet_count\n\
      \        self.message_port_pub(pmt.intern(\"packet\"), pmt.to_pmt(measurement))\n        if self._status_led is not None:\n            self._set_status_led(self._status_led_value.ACTIVE)\n            self._status_led_deadline = time.monotonic() + 0.12\n\
      \        rf = \"\"\n        if \"snr\" in measurement:\n            rf = (f\"\
      \ rssi={measurement['rssi']:.2f} dBFS\"\n                  f\" noise={measurement['noise']:.2f}\
      \ dBFS\"\n                  f\" snr={measurement['snr']:.2f} dB\")\n       \
      \ freq_text = \"\"\n        if \"freq1\" in measurement and \"freq2\" in measurement:\n\
      \            freq_text = (f\" fsk={measurement['freq2']:.4f}/{measurement['freq1']:.4f}MHz\"\
      \n                         f\" dev={measurement['fsk_deviation_khz']:.1f}kHz\"\
      )\n        if LOG_LEVEL != \"quiet\":\n            print(\n                f\"\
      PKT id={sensor_id} current={measurement['current']:.3f}A \"\n              \
      \  f\"interval={measurement['interval']}s \"\n                f\"snr={measurement.get('snr',\
      \ float('nan')):.1f}dB \"\n                f\"rx={measurement['reception_rate']:.1f}%\
      \ \"\n                f\"missed~{measurement['packets_missed_est']} \"\n   \
      \             f\"checksum=OK\",\n                flush=True)\n\n    def _report_stats(self):\n\
      \        s = self.stats\n        rejected = s[\"captures\"] - s[\"valid\"]\n\
      \        on, off = self._thresholds()\n        print(\n            \"STATS cumulative\
      \ \"\n            f\"captures={s['captures']} valid={s['valid']} rejected={rejected}\
      \ \"\n            f\"too_short={s['too_short']} no_sync={s['no_sync']} \"\n\
      \            f\"no_64_symbols={s['no_64_symbols']} \"\n            f\"checksum_failed={s['checksum_failed']}\
      \ \"\n            f\"invalid_payload={s['invalid_payload']} \"\n           \
      \ f\"capture_timeout={s['capture_timeout']} \"\n            f\"noise={self.noise:.6g}\
      \ on={on:.6g} off={off:.6g}\", flush=True)\n\n    def _reject(self, reason,\
      \ duration_ms, details=\"\"):\n        self.reject_count += 1\n        self.stats[reason]\
      \ += 1\n        self.monitor_rejected += 1\n        if self.debug or LOG_LEVEL\
      \ == \"debug\":\n            print(f\"REJECT {reason} duration={duration_ms:.2f}ms\
      \ {details}\", flush=True)\n\n    def _decode_capture(self, samples, powers,\
      \ demod, noise_power, release_threshold):\n        duration_ms = len(samples)\
      \ / self.fs * 1000\n        if samples.size < round(0.005 * self.fs):\n    \
      \        self._reject(\"too_short\", duration_ms)\n            return\n    \
      \    edges = np.flatnonzero(np.diff(samples.astype(np.int16))) + 1\n       \
      \ starts = np.r_[0, edges]\n        ends = np.r_[edges, samples.size]\n    \
      \    levels = samples[starts]\n        lengths = ends - starts\n        has_sync\
      \ = False\n        has_window = False\n        has_checksum_failure = False\n\
      \        polarities = []\n        for polarity in (1, 0):\n            widths\
      \ = lengths[levels == polarity] / self.fs * 1e6\n            sync_idx = np.flatnonzero((widths\
      \ >= 300) & (widths <= 800))\n            has_sync |= bool(sync_idx.size)\n\
      \            symbols = []\n            for width in widths:\n              \
      \  if 35 <= width < 100:\n                    symbols.append(0)\n          \
      \      elif 100 <= width <= 190:\n                    symbols.append(1)\n  \
      \              else:\n                    symbols.append(None)\n           \
      \ starts_to_try = sorted(set(\n                [int(i) + 1 for i in sync_idx]\n\
      \                + list(range(max(0, len(symbols) - 63)))\n            ))\n\
      \            polarities.append(f\"{polarity}:{len(widths)}p/{len(sync_idx)}sync\"\
      )\n            for start in starts_to_try:\n                chunk = symbols[start:start\
      \ + 64]\n                if len(chunk) != 64 or any(bit is None for bit in chunk):\n\
      \                    continue\n                has_window = True\n         \
      \       for invert in (False, True):\n                    bits = [bit ^ int(invert)\
      \ for bit in chunk]\n                    raw = bytes(\n                    \
      \    int(\"\".join(str(b) for b in bits[i:i + 8]), 2)\n                    \
      \    for i in range(0, 64, 8)\n                    )\n                    if\
      \ (raw[0] & 0xF0) == 0xF0:\n                        raw = bytes(b ^ 0xFF for\
      \ b in raw)\n                    if (raw[0] & 0xF0) == 0 and sum(b == 0 for\
      \ b in raw) <= 5:\n                        if (sum(raw[:7]) & 0xFF) != raw[7]:\n\
      \                            has_checksum_failure = True\n                 \
      \   measurement = self._decode_payload(raw)\n                    if measurement\
      \ is not None:\n                        metrics = self._rf_metrics(powers, noise_power,\
      \ release_threshold)\n                        if metrics is not None:\n    \
      \                        measurement.update(metrics)\n                     \
      \   measurement.update(self._frequency_metrics(samples, powers, demod, release_threshold))\n\
      \                        self._publish_packet(measurement)\n               \
      \         return\n        if not has_window:\n            reason = \"no_64_symbols\"\
      \ if has_sync else \"no_sync\"\n        elif has_checksum_failure:\n       \
      \     reason = \"checksum_failed\"\n        else:\n            reason = \"invalid_payload\"\
      \n        self._reject(reason, duration_ms,\n                     f\"polarity={','.join(polarities)}\
      \ valid_64bit_window={has_window}\")\n"
    affinity: ''
    alias: ''
    center_freq: freq
    comment: ''
    debug: 'False'
    detection_mode: '"adaptive"'
    detection_snr_db: '10.0'
    initial_noise_power: '0.00012'
    maxoutbuf: '0'
    min_detection_us: '100'
    minoutbuf: '0'
    noise_time_constant: '1.0'
    release_snr_db: '6.0'
    sample_rate: samp_rate / 2
    threshold_off: '0.003'
    threshold_on: '0.01'
  states:
    _io_cache: ('Engage E2CT Decoder', 'blk', [('sample_rate', '500000'), ('detection_mode',
      "'adaptive'"), ('detection_snr_db', '10.0'), ('release_snr_db', '6.0'), ('noise_time_constant',
      '1.0'), ('min_detection_us', '100.0'), ('threshold_on', '0.01'), ('threshold_off',
      '0.003'), ('initial_noise_power', '0.00012'), ('center_freq', '433530000.0'),
      ('debug', 'False')], [('0', 'byte', 1), ('1', 'float', 1), ('2', 'float', 1)],
      [('packet', 'message', 1)], '', ['center_freq', 'debug'])
